# Copy this file to .env and edit every path for your machine.
# Use forward slashes in Windows paths for Docker volume mapping.

# Root of your Unreal project after installing the Embodied Space Studio Fab plugin.
# The folder must contain Plugins/KimodoMotionAuthoring/Resources/Python/kimodo_ue_service/server.py
ESS_UNREAL_PROJECT_ROOT=C:/Users/YourName/Documents/Unreal Projects/YourProject

# Local Hugging Face cache and host username.
# Use the cache that contains the token created by `hf auth login`, or keep the
# local bridge cache and place the token under ./.cache/huggingface/token.
HF_HOME_HOST=C:/Users/YourName/.cache/huggingface
HOST_USER=YourWindowsUserName

# Optional Kimodo web demo port.
SERVER_PORT=7860

# Text encoder model folders. Download these from Hugging Face, then set the paths below.
TEXT_ENCODER_BASE_MODEL_HOST=./text-encoders/McGill-NLP/LLM2Vec-Meta-Llama-3-8B-Instruct-mntp
TEXT_ENCODER_MNTP_ADAPTER_HOST=./text-encoders/McGill-NLP/LLM2Vec-Meta-Llama-3-8B-Instruct-mntp-adapter
TEXT_ENCODER_ADAPTER_HOST=./text-encoders/McGill-NLP/LLM2Vec-Meta-Llama-3-8B-Instruct-mntp-supervised

# Text encoder device is applied when Docker creates/recreates the text-encoder container.
# Valid values: auto, cuda, cpu. Use cuda, not gpu, to force GPU.
TEXT_ENCODER_DEVICE=auto

# Unreal bridge host port. The plugin uses http://127.0.0.1:18027/bridge/v1 by default.
UE_BRIDGE_HOST_PORT=18027
